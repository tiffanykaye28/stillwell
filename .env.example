# Copy to .env.local for `vercel dev`, then set private server environment values.
# Never put any of these secrets in dist/config.js or browser code.
SUPABASE_URL=https://zwltlwggnvyempxrkdhp.supabase.co
SUPABASE_SECRET_KEY=replace_with_your_server_secret_key
SUPABASE_SERVICE_ROLE_KEY=replace_with_your_service_role_key
GEMINI_API_KEY=replace_with_your_gemini_api_key
GEMINI_MODEL=replace_with_your_gemini_model
# Keep false with an unpaid Gemini project. Enable only after configuring
# a suitable paid-service project and reviewing the personal-chat disclosures.
LUMI_PERSONAL_CHAT_ENABLED=false
# Private username alias for an existing Supabase counselor/admin account.
STAFF_LOGIN_USERNAME=replace_with_staff_username
STAFF_LOGIN_EMAIL=replace_with_staff_auth_email
# Public operator information; never put secrets in these variables.
PUBLIC_OPERATOR_NAME=
PUBLIC_COUNTRY=
PUBLIC_PRIVACY_EMAIL=
PUBLIC_COUNSELING_EMAIL=
PUBLIC_COUNSELING_PHONE=
PUBLIC_COUNSELING_HOURS=
PUBLIC_RETENTION_NOTICE=
